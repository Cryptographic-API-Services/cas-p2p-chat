{
  "name": "@cas-p2p-chat/core",
  "version": "0.1.0",
  "private": true,
  "description": "Protocol, identity, signed directory records and signaling tokens, shared by the desktop app and the server, plus the desktop app's local database (SQLite through Drizzle).",
  "type": "module",
  "license": "ISC",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "cas-source": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "cas-typescript-sdk": "^2.1.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3"
  }
}
