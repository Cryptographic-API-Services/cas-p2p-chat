{
  // Node runs these sources directly (type stripping), so only erasable syntax and explicit .ts
  // imports. The emitted dist/ is for the desktop app's main process, which Electron runs as JS.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
