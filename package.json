{
  "name": "cas-p2p-chat",
  "productName": "CAS P2P Chat",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end encrypted peer-to-peer desktop chat over WebRTC (Electron, Vue, Vuetify, Tailwind) with an Express server for signaling and find-by-name, built on cas-typescript-sdk.",
  "main": "dist/src/main/main.js",
  "type": "commonjs",
  "license": "ISC",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vue-tsc -p tsconfig.renderer.json && vite build --logLevel warn",
    "start": "npm run build && electron .",
    "start:alice": "npm run build && electron . --profile=alice --name=Alice --server=http://127.0.0.1:8787",
    "start:bob": "npm run build && electron . --profile=bob --name=Bob --server=http://127.0.0.1:8787",
    "server": "npm run build:main && node dist/src/server/server.js",
    "test": "npm run build:main && node --test \"dist/test/**/*.test.js\"",
    "smoke": "npm run build && electron . --smoke-test"
  },
  "dependencies": {
    "cas-typescript-sdk": "^2.0.0",
    "express": "^5.3.0",
    "peer": "^1.0.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.5.0",
    "peerjs": "^1.5.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14",
    "vuetify": "^4.3.4"
  }
}
