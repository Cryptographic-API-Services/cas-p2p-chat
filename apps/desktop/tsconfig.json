{
  // Main process, preloads and smoke test. The renderer is type-checked by tsconfig.renderer.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "sourceMap": true
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.d.ts"],
  "references": [{ "path": "../../packages/core" }]
}
