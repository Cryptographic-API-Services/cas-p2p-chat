    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "peer": "^1.0.2",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3"
  }
